<meta>
    <info author="MTA Neon" name="Newmodels Neon" type="script" version="1.0.0" description="Server-authoritative custom model registry with client asset streaming." />

    <!-- Production library: server registry/scan and client asset loading only.
         No shared scripts — folder scan and settings helpers stay server-side. -->
    <script src="server/newmodels.lua" type="server" />
    <script src="client/load_model_assets.lua" type="client" cache="false" />

    <!-- Optional test harness (safe to remove on production servers):
         - demo_commands_server.lua: /newmodelspawn and /newmodelinfo
         - demo_inspect_client.lua: /newmodelclient logical/runtime mapping dump
         Remove these two scripts if you only need the library exports.
         Bundled files under models/ are example assets; replace or delete them when
         deploying your own model tree. -->
    <script src="test/demo_commands_server.lua" type="server" />
    <script src="test/demo_inspect_client.lua" type="client" cache="false" />

    <!-- Example model assets (optional): glob your own models/ tree or remove demo folders. -->
    <file src="models/**/*" />

    <export function="getModelCatalog" type="server" />
    <export function="registerModels" type="server" />
    <export function="isModelLoaded" type="client" />
    <export function="getLoadedModels" type="client" />
    <export function="getClientCatalog" type="client" />
</meta>
